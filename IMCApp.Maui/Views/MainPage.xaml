<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IMCApp.Maui.Views.MainPage"
             Title="Indice de masa coorporal">
    <ScrollView>
        <VerticalStackLayout
            Padding="16"
            Spacing="24">
            <Border
                Stroke="LightGrey"
                StrokeThickness="2">
                <Grid
                    RowDefinitions="*,*"
                    ColumnDefinitions="Auto,*"
                    RowSpacing="8"
                    ColumnSpacing="4"
                    Padding="16"
                    >
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalOptions="Center"
                        Text="Proporcione el peso en kilogramos:"
                    />
                    <Entry
                        Grid.Row="0"
                        Grid.Column="1"
                        BackgroundColor="White"
                        Text="{Binding Peso}"
                        Keyboard="Numeric"
                        ClearButtonVisibility="WhileEditing"
                        TextColor="Black"/>
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalOptions="Center"
                        Text="Proporcione la altura en metros: "/>
                    <Entry
                        Grid.Row="1"
                        Grid.Column="1"
                        BackgroundColor="White"
                        Text="{Binding Estatura}"
                        Keyboard="Numeric"
                        ClearButtonVisibility="WhileEditing"
                       TextColor="Black"/>
                </Grid> 
            </Border>
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="16">
                <Button
                    BackgroundColor="Aqua"
                    Text="Calcular"
                    Command="{Binding Path=CalcularCommand}"
                    MinimumWidthRequest="80"
                    />
                <Button
                    BackgroundColor="Aqua"
                    Text="Limpiar"
                    Command="{Binding Path=LimpiarCommand}"
                    MinimumWidthRequest="80"
                    />
            </HorizontalStackLayout>
            <Border
                Stroke="LightGrey"
                StrokeThickness="2">
                <VerticalStackLayout
                Padding="16"
                Spacing="4">
                    <Label
                        Text="El indice de masa cooporal de la persona es: "/>
                    <Label
                     
                        Text="{Binding Path=Imc}"
                        HorizontalOptions="Center"
                        FontSize="Medium"
                        FontAttributes="Bold"
                        />
                    <Label
                        Text="La situcion nutricional de la persona es: "/>
                    <Label
                        
                        HorizontalOptions="Center"
                        FontSize="Medium"
                        FontAttributes="Bold"
                        Text="{Binding Path= SituacionNutricional}"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    
    
</ContentPage>